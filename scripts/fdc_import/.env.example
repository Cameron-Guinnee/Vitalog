# Settings for the food import. Copy to scripts/fdc_import/.env, which git ignores.

# Project Settings → Data API in Supabase
SUPABASE_URL=https://your-project-ref.supabase.co

# The service role key (or a secret key), from Project Settings → API Keys.
# It bypasses row-level security, so keep it on your machine and never in the web app.
# Not needed for --dry-run.
SUPABASE_SERVICE_KEY=

# Optional
# FDC_DATA_DIR=data/fdc
# FDC_BATCH_SIZE=500
